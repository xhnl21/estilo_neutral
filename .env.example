# Modelo de las variables de entorno de Estilo Neutral. Copiarlo como .env.dev,
# .env.test y .env (ver docs/configuracion-local.md §2.1) y ajustar cada uno.
# Detalle de cada variable: docs/configuracion-local.md §2.1

# ATENCIÓN: apunta a la hoja y al Apps Script de PRODUCCIÓN (no hay un entorno
# de pruebas accesible todavía; ver informe.md §3.1): lo que se guarde es real.

# --- Las lee la app (constantes de compilación) ---
# Entorno: dev | qa | prod
ENVIRONMENT=dev
# ID de la hoja de Google Sheets (o su URL completa)
SPREADSHEET_ID=1V8xBnRVtZUyz4liGW59BU6mkgCjjreEOEWzySjcZLvI
# URL /exec de la implementación del Apps Script que recibe las escrituras
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby6Jg1oaFa2yJAlEuDThxZhmDvI-LPu80KDedz-qMFn9h1rbvJoTANwG3ufbOYBjDq7ZA/exec
# Modo depuración y logs en consola
DEBUG_MODE=true
ENABLE_LOGS=true
# Mostrar nombres de hojas y metadatos técnicos en pantalla
SHOW_TECHNICAL_INFO=true

# --- Informativas (la app no las lee: el nombre y el paquete los fija cada
#     variante en android/app/build.gradle.kts) ---
APP_NAME=Estilo Neutral (Dev)
APP_PACKAGE_NAME=com.estiloneutral.es.dev

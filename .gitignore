client_secret*.json

# MkDocs — sitio generado, no se commitea
/site/


# Claude Code: configuración local (no se commitea)
.claude/settings.local.json

# Respaldos locales de la hoja de producción (datos personales)
respaldos/
# Respaldo técnico local de credenciales y configuraciones ignoradas
respaldo_tecnico/

# Configuración de Firebase (FCM): la descarga cada uno desde la consola (ver informe.md §2)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# Descargas de google-services.json de la consola (con sufijo) en la raíz
/google-services*.json
# Claves de cuentas de servicio descargadas a mano (FCM u otras): nunca se commitean
/fcm-clave-*.json
*-service-account*.json
# Credencial FCM generada por deploy.sh (contiene la clave privada)
/credencial_fcm.js
tools/apps_script_test/credencial_fcm.js

# Builds de release copiados por tools/deploy.sh
/dist/

# Log de errores de script/script.sh (se regenera en cada ejecución)
script/log_script.txt
